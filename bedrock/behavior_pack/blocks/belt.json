{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "createbedrock:belt",
      "menu_category": { "category": "items", "group": "itemGroup.name.misc" },
      "properties": {
        "createbedrock:belt_segment": ["single", "start", "middle", "end"]
      },
      "traits": { "minecraft:placement_direction": { "enabled_states": ["minecraft:facing_direction"] } }
    },
    "components": {
      "minecraft:destructible_by_explosion": { "explosion_resistance": 2 },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 0.5 },
      "minecraft:geometry": "geometry.createbedrock.belt",
      "minecraft:item_visual": { "geometry": { "identifier": "geometry.createbedrock.belt" }, "material_instances": { "*": { "texture": "createbedrock_belt", "render_method": "opaque" } } },
      "minecraft:loot": "loot_tables/blocks/belt.json",
      "minecraft:material_instances": { "*": { "texture": "createbedrock_belt", "render_method": "opaque" } }
    },
    "permutations": [
      { "condition": "query.block_state('createbedrock:belt_segment') == 'start'", "components": { "minecraft:geometry": "geometry.createbedrock.belt_start" } },
      { "condition": "query.block_state('createbedrock:belt_segment') == 'end'", "components": { "minecraft:geometry": "geometry.createbedrock.belt_end" } },
      { "condition": "query.block_state('minecraft:facing_direction') == 2 || query.block_state('minecraft:facing_direction') == 3", "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } } }
    ]
  }
}
