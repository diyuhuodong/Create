{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "createbedrock:mechanical_crafter",
      "menu_category": {
        "category": "items",
        "group": "itemGroup.name.misc"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:facing_direction"]
        }
      }
    },
    "components": {
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 6
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5
      },
      "minecraft:geometry": "geometry.createbedrock.mechanical_crafter",
      "minecraft:loot": "loot_tables/blocks/mechanical_crafter.json",
      "minecraft:item_visual": {
        "geometry": {
          "identifier": "geometry.createbedrock.mechanical_crafter"
        },
        "material_instances": {
          "crafter_thingies": { "texture": "createbedrock_crafter_thingies", "render_method": "opaque" },
          "crafter_side": { "texture": "createbedrock_crafter_side", "render_method": "opaque" },
          "brass_casing": { "texture": "createbedrock_brass_casing", "render_method": "opaque" },
          "brass_block": { "texture": "createbedrock_brass_block", "render_method": "opaque" },
          "smooth_dark_log_top": { "texture": "createbedrock_smooth_dark_log_top", "render_method": "opaque" },
          "cogwheel": { "texture": "createbedrock_cogwheel", "render_method": "opaque" },
          "*": { "texture": "createbedrock_brass_casing", "render_method": "opaque" }
        }
      },
      "minecraft:material_instances": {
        "crafter_thingies": { "texture": "createbedrock_crafter_thingies", "render_method": "opaque" },
        "crafter_side": { "texture": "createbedrock_crafter_side", "render_method": "opaque" },
        "brass_casing": { "texture": "createbedrock_brass_casing", "render_method": "opaque" },
        "brass_block": { "texture": "createbedrock_brass_block", "render_method": "opaque" },
        "smooth_dark_log_top": { "texture": "createbedrock_smooth_dark_log_top", "render_method": "opaque" },
        "cogwheel": { "texture": "createbedrock_cogwheel", "render_method": "opaque" },
        "*": { "texture": "createbedrock_brass_casing", "render_method": "opaque" }
      }
    },
    "permutations": [
      { "condition": "query.block_state('minecraft:facing_direction') == 0", "components": { "minecraft:transformation": { "rotation": [180, 0, 0] } } },
      { "condition": "query.block_state('minecraft:facing_direction') == 2", "components": { "minecraft:transformation": { "rotation": [90, 0, 0] } } },
      { "condition": "query.block_state('minecraft:facing_direction') == 3", "components": { "minecraft:transformation": { "rotation": [-90, 0, 0] } } },
      { "condition": "query.block_state('minecraft:facing_direction') == 4", "components": { "minecraft:transformation": { "rotation": [0, 0, 90] } } },
      { "condition": "query.block_state('minecraft:facing_direction') == 5", "components": { "minecraft:transformation": { "rotation": [0, 0, -90] } } }
    ]
  }
}
