      "minecraft:destructible_by_mining": { "seconds_to_destroy": 1 },
      "minecraft:geometry": "geometry.createbedrock.contraption_controls",
      "minecraft:loot": "loot_tables/blocks/contraption_controls.json",
      "minecraft:item_visual": {
        "geometry": { "identifier": "geometry.createbedrock.contraption_controls" },
        "material_instances": {
