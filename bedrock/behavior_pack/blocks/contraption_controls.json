{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "createbedrock:contraption_controls",
      "menu_category": { "category": "items", "group": "itemGroup.name.misc" },
      "properties": { "createbedrock:disabled": [0, 1] },
