{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "createbedrock:mechanical_piston",
      "menu_category": { "category": "items", "group": "itemGroup.name.misc" },
      "traits": { "minecraft:placement_direction": { "enabled_states": ["minecraft:facing_direction"] } }
    },
    "components": {
      "minecraft:destructible_by_explosion": { "explosion_resistance": 6 },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 1 },
      "minecraft:geometry": "geometry.createbedrock.mechanical_piston",
      "minecraft:loot": "loot_tables/blocks/mechanical_piston.json",
      "minecraft:item_visual": { "geometry": { "identifier": "geometry.createbedrock.mechanical_piston" }, "material_instances": { "*": { "texture": "createbedrock_andesite_casing_piston", "render_method": "opaque" } } },
      "minecraft:material_instances": { "*": { "texture": "createbedrock_andesite_casing_piston", "render_method": "opaque" } }
    },
    "permutations": [
      { "condition": "query.block_state('minecraft:facing_direction') == 0", "components": { "minecraft:transformation": { "rotation": [180, 0, 0] } } },
      { "condition": "query.block_state('minecraft:facing_direction') == 2", "components": { "minecraft:transformation": { "rotation": [90, 0, 0] } } },
      { "condition": "query.block_state('minecraft:facing_direction') == 3", "components": { "minecraft:transformation": { "rotation": [90, 180, 0] } } },
      { "condition": "query.block_state('minecraft:facing_direction') == 4", "components": { "minecraft:transformation": { "rotation": [90, 270, 0] } } },
      { "condition": "query.block_state('minecraft:facing_direction') == 5", "components": { "minecraft:transformation": { "rotation": [90, 90, 0] } } }
    ]
  }
}
