{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "createbedrock:display_board",
      "menu_category": {
        "category": "items",
        "group": "itemGroup.name.misc"
      },
      "properties": {
        "createbedrock:active": [0, 1],
        "createbedrock:glowing": [0, 1]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:facing_direction"]
        }
      }
    },
    "components": {
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 6
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 2
      },
      "minecraft:geometry": "geometry.createbedrock.display_board",
      "minecraft:collision_box": {
        "origin": [-8, -8, -3],
        "size": [16, 16, 6]
      },
      "minecraft:selection_box": {
        "origin": [-8, -8, -3],
        "size": [16, 16, 6]
      },
      "minecraft:loot": "loot_tables/blocks/display_board.json",
      "minecraft:item_visual": {
        "geometry": {
          "identifier": "geometry.createbedrock.display_board"
        },
        "material_instances": {
          "flap_display_front": {
            "texture": "createbedrock_flap_display_front",
            "render_method": "opaque"
          },
          "dark_metal_block": {
            "texture": "createbedrock_dark_metal_block",
            "render_method": "opaque"
          },
          "flap_display_side": {
            "texture": "createbedrock_flap_display_side",
            "render_method": "opaque"
          },
          "flap_display_top": {
            "texture": "createbedrock_flap_display_top",
            "render_method": "opaque"
          },
          "flap_display_inside": {
            "texture": "createbedrock_flap_display_inside",
            "render_method": "opaque"
          },
          "*": {
            "texture": "createbedrock_flap_display_front",
            "render_method": "opaque"
          }
        }
      },
      "minecraft:material_instances": {
        "flap_display_front": {
          "texture": "createbedrock_flap_display_front",
          "render_method": "opaque"
        },
        "dark_metal_block": {
          "texture": "createbedrock_dark_metal_block",
          "render_method": "opaque"
        },
        "flap_display_side": {
          "texture": "createbedrock_flap_display_side",
          "render_method": "opaque"
        },
        "flap_display_top": {
          "texture": "createbedrock_flap_display_top",
          "render_method": "opaque"
        },
        "flap_display_inside": {
          "texture": "createbedrock_flap_display_inside",
          "render_method": "opaque"
        },
        "*": {
          "texture": "createbedrock_flap_display_front",
          "render_method": "opaque"
        }
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('minecraft:facing_direction') == 0",
        "components": {
          "minecraft:transformation": {
            "rotation": [180, 0, 0]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:facing_direction') == 2",
        "components": {
          "minecraft:transformation": {
            "rotation": [90, 0, 0]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:facing_direction') == 3",
        "components": {
          "minecraft:transformation": {
            "rotation": [90, 180, 0]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:facing_direction') == 4",
        "components": {
          "minecraft:transformation": {
            "rotation": [90, 270, 0]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:facing_direction') == 5",
        "components": {
          "minecraft:transformation": {
            "rotation": [90, 90, 0]
          }
        }
      },
      {
        "condition": "query.block_state('createbedrock:active') == 1 && query.block_state('createbedrock:glowing') == 1",
        "components": {
          "minecraft:light_emission": 6
        }
      }
    ]
  }
}
