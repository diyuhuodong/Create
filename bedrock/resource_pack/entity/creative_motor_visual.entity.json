{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "createbedrock:creative_motor_visual",
      "geometry": {
        "horizontal": "geometry.createbedrock.creative_motor_visual_horizontal",
        "vertical": "geometry.createbedrock.creative_motor_visual_vertical"
      },
      "materials": { "default": "entity_alphatest" },
      "textures": {
        "motor": "textures/createbedrock/kinetics/creative_motor_atlas"
      },
      "render_controllers": ["controller.render.createbedrock.creative_motor"],
      "animations": {
        "creative_motor_visual": "animation.createbedrock.creative_motor_visual",
        "creative_motor_visual_controller": "controller.animation.createbedrock.creative_motor_visual"
      },
      "scripts": {
        "initialize": [
          "variable.rotation_angle = 0;",
          "variable.last_server_phase = 1000000;"
        ],
        "pre_animation": [
          "variable.facing = query.property('createbedrock:facing');",
          "variable.rpm = query.property('createbedrock:rpm');",
          "variable.server_phase = query.property('createbedrock:phase');",
          "variable.rotation_angle = variable.server_phase != variable.last_server_phase ? variable.server_phase : variable.rotation_angle + variable.rpm * 6 * query.delta_time;",
          "variable.last_server_phase = variable.server_phase;",
          "variable.root_x = variable.facing == 0 ? 180 : 0;",
          "variable.root_y = variable.facing == 2 ? 180 : variable.facing == 4 ? 90 : variable.facing == 5 ? -90 : 0;"
        ],
        "animate": ["creative_motor_visual_controller"]
      }
    }
  }
}
