{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "createbedrock:wrench",
      "item": {
        "createbedrock:wrench": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/create_java/item/wrench",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.createbedrock.wrench"
      },
      "animations": {
        "gear_spin": "animation.createbedrock.wrench.gear_spin"
      },
      "scripts": {
        "animate": [
          "gear_spin"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
