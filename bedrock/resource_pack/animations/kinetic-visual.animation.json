{
  "format_version": "1.8.0",
  "animations": {
    "animation.createbedrock.kinetic_visual_rotation": {
      "animation_length": 1,
      "loop": true,
      "bones": {
        "java_model": {
          "rotation": [
            "query.property('createbedrock:axis') == 2 ? 90 : 0",
            "query.anim_time * query.property('createbedrock:rpm') * 6",
            "query.property('createbedrock:axis') == 0 ? 90 : 0"
          ]
        },
        "crushing_wheel": {
          "rotation": [
            "query.property('createbedrock:axis') == 2 ? 90 : 0",
            "query.anim_time * query.property('createbedrock:rpm') * 6",
            "query.property('createbedrock:axis') == 0 ? 90 : 0"
          ]
        }
      }
    },
    "animation.createbedrock.crushing_wheel_visual": {
      "animation_length": 1,
      "loop": true,
      "bones": {
        "crushing_wheel_orientation": {
          "rotation": ["variable.root_x", 0, "variable.root_z"]
        },
        "crushing_wheel": {
          "rotation": [0, "variable.rotation_angle", 0]
        }
      }
    },
    "animation.createbedrock.creative_motor_visual": {
      "animation_length": 1,
      "loop": true,
      "bones": {
        "motor_root": {
          "rotation": ["variable.root_x", "variable.root_y", 0]
        },
        "motor_shaft_horizontal": {
          "rotation": [0, 0, "variable.rotation_angle"]
        },
        "motor_shaft_vertical": {
          "rotation": [0, "variable.rotation_angle", 0]
        }
      }
    }
  }
}
